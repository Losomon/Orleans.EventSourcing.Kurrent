<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orleans.EventSourcing.Kurrent</PackageId>
    <Authors>William Gunaratne</Authors>
    <Title>Kurrent for Microsoft Orleans Event-Sourcing</Title>
    <Description>Kurrent client implementation of log consistency provider for Microsoft Orleans EventSourcing.</Description>
    <RootNamespace>Orleans.EventSourcing.Kurrent</RootNamespace>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1873</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The package's own implementation of IGrainEventProvider intentionally consumes the experimental API. -->
    <NoWarn>$(NoWarn);OEK0001</NoWarn>
  </PropertyGroup>	
  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.EventSourcing.Kurrent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KurrentDB.Client" />
    <PackageReference Include="Microsoft.Orleans.EventSourcing" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <!-- Pin transitive OpenTelemetry.Api above the vulnerable 1.12.0 brought in by KurrentDB.Client (GHSA-g94r-2vxg-569j). -->
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>
</Project>